datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// @@auth
/// @@allow('all', has(auth().role, 'admin'))
model SystemUser {
  id            String    @id() @default(cuid())
  name          String?
  email         String?   @unique()
  password      String?
  emailVerified DateTime?
  image         String?
  role          String[]
}

model Client {
  id              Int              @id() @default(autoincrement())
  fantasyName     String?
  companyName     String
  cnpj            String
  cnaeDescription String?
  cnaeCode        String?
  openingDate     String?
  address         Json?
  contactNumber   String?
  contactEmail    String?
  createdAt       DateTime?        @default(now())
  updatedAt       DateTime?        @updatedAt()
  contacts        Json?
  requests        ProductRequest[]
}

model Employee {
  id            Int            @id() @default(autoincrement())
  firstName     String
  lastName      String?
  rg            String?
  cpf           String?
  pis           String?
  ctps          String?
  contactNumber String?
  contactEmail  String?        @unique()
  address       Json?
  typeHiring    String?
  hiringDate    String?
  position      String?
  salary        String?
  workLoad      String?
  comment       String?
  image         EmployeeImage?
  files         EmployeeFile[]
}

model EmployeeFile {
  id         Int      @id() @default(autoincrement())
  filename   String
  url        String
  type       String
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model EmployeeImage {
  id         Int      @id() @default(autoincrement())
  filename   String
  url        String
  type       String
  employeeId Int      @unique()
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model ProductRequest {
  id        Int      @id() @default(autoincrement())
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  deadLine  String?
  clientId  Int?
  client    Client?  @relation(fields: [clientId], references: [id])
  items     Json
}
